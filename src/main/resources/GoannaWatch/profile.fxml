<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox id="contentContainer"
      alignment="TOP_CENTER"
      prefWidth="800"
      prefHeight="800"
      stylesheets="@pageStyling.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GoannaWatch.account.controller.ProfileController">

    <Label text="Goanna Watch"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <VBox id="pageContent" maxWidth="420">

        <Label id="pageTitle" text="My Profile" />

        <Label id="userInputLabel" text="First Name" />
        <TextField id="userInput"
                   fx:id="firstNameTextField" />

        <Label id="userInputLabel" text="Last Name" />
        <TextField id="userInput"
                   fx:id="lastNameTextField" />

        <Label id="userInputLabel" text="Email Address" />
        <TextField id="userInput"
                   fx:id="emailTextField" />

        <Label fx:id="feedbackLabel"
               text=""
               wrapText="true"
               maxWidth="Infinity" />

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="backButton"
                    text="Back"
                    onAction="#onBackButtonClick" />

            <Button text="Save"
                    defaultButton="true"
                    onAction="#onSaveButtonClick" />
        </HBox>

    </VBox>
</VBox>
