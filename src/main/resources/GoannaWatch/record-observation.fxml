<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0"
      stylesheets="@pageStyling.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      prefHeight="800" prefWidth="800"
      fx:controller="GoannaWatch.observations.controller.RecordObservationController">

    <fx:include fx:id="navBar" source="navbar.fxml" />

    <fx:define>
        <ToggleGroup fx:id="endangeredGroup" />
    </fx:define>

    <VBox spacing="15.0" maxWidth="500">
        <padding>
            <Insets top="10.0" right="20.0" bottom="20.0" left="20.0" />
        </padding>

        <Label text="Record a New Observation" id="pageTitle" wrapText="true" />

        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="90" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="Location:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="locationTextField" promptText="Start typing a place..."
                       GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Animal:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="speciesComboBox" editable="true" maxWidth="Infinity"
                      GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Endangered:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <RadioButton fx:id="endangeredYesRadio" text="Yes" toggleGroup="$endangeredGroup" />
                <RadioButton fx:id="endangeredNoRadio" text="No" toggleGroup="$endangeredGroup" />
            </HBox>

            <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        </GridPane>

        <HBox spacing="10.0">
            <Button text="Submit" onAction="#onSubmit" defaultButton="true" />
            <Button text="Clear" onAction="#onClear" />
            <Label fx:id="statusLabel" />
        </HBox>
    </VBox>
</VBox>