<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox id="contentContainer"
      prefHeight="800"
      prefWidth="800"
      stylesheets="@pageStyling.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GoannaWatch.account.controller.LandingController">

    <fx:include fx:id="navBar" source="navbar.fxml" />

    <VBox alignment="CENTER" spacing="4">
        <Label fx:id="welcomeLabel"
               alignment="CENTER"
               style="-fx-font-size: 26px; -fx-font-weight: bold;"
               text="Welcome!"
               textAlignment="CENTER"
               wrapText="true"/>
        <Label fx:id="emailLabel" text="" />
    </VBox>

    <GridPane alignment="TOP_CENTER"
              hgap="10"
              vgap="10">

        <VBox alignment="TOP_CENTER">
            <HBox>
                <VBox id="pageContent">
                    <Label text="Recent Observations">
                        <font>
                            <Font name="System Bold"
                                  size="12.0" />
                        </font>
                    </Label>

                    <Label text="Observation 1" />
                    <Label text="Observation 2" />
                    <Label text="Observation 3" />
                    <Label text="Observation 4" />
                </VBox>

                <VBox id="contentContainer">
                    <VBox id="pageContent">
                        <Label text="Observation Map Preview">
                            <font>
                                <Font name="System Bold"
                                      size="12.0" />
                            </font>
                        </Label>
                    </VBox>

                    <VBox id="pageContent">
                        <Label text="Selected Observation">
                            <font>
                                <Font name="System Bold"
                                      size="12.0" />
                            </font>
                        </Label>
                    </VBox>
                </VBox>

                <VBox id="contentContainer">
                    <VBox id="pageContent">
                        <Label text="Quick Actions">
                            <font>
                                <Font name="System Bold"
                                      size="12.0" />
                            </font>
                        </Label>
                    </VBox>

                    <VBox id="pageContent">
                        <Label text="Wildlife Resources">
                        <font>
                            <Font name="System Bold"
                                  size="12.0" />
                        </font>
                        </Label>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </GridPane>
</VBox>
