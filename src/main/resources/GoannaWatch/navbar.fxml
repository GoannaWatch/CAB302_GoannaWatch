<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.ToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      styleClass="navbar"
      fx:controller="GoannaWatch.account.controller.NavBarController">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <padding><Insets top="14" right="24" bottom="4" left="24" /></padding>

        <Label text="Goanna Watch" styleClass="title-3, accent" />
        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="pageTitleLabel" styleClass="title-3" />
        <Separator orientation="VERTICAL" />
        <ToggleSwitch fx:id="themeToggle" text="Dark mode" />

        <MenuButton fx:id="profileMenu" text="Profile" styleClass="flat">
            <items>
                <MenuItem text="Account settings" onAction="#onProfileButtonClick" />
                <SeparatorMenuItem />
                <MenuItem text="Log out" onAction="#onLogoutButtonClick" />
            </items>
        </MenuButton>
    </HBox>

    <HBox fx:id="navButtons" alignment="CENTER_LEFT" spacing="4">
        <padding><Insets top="4" right="20" bottom="10" left="20" /></padding>

        <Button text="Dashboard" userData="Dashboard" styleClass="flat" onAction="#onDashboardButtonClick" />
        <Button text="Record" userData="Record" styleClass="flat" onAction="#onRecordObservationClick" />
        <Button text="History" userData="History" styleClass="flat" onAction="#onHistoryButtonClick" />
        <Button text="Map" userData="Map" styleClass="flat" onAction="#onMapButtonClick" />
        <Button text="Endangered" userData="Endangered" styleClass="flat" onAction="#onEndangeredButtonClick" />
        <Button text="Favourites" userData="Favourites" styleClass="flat" onAction="#onFavouritesButtonClick" />
        <Button fx:id="usersButton" text="Manage Users" userData="Users" styleClass="flat"
                onAction="#onUsersButtonClick" visible="false" managed="false" />
    </HBox>
</VBox>