<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="bg-inset" alignment="CENTER"
      stylesheets="@pageStyling.css"
      prefHeight="800" prefWidth="800"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GoannaWatch.account.controller.LoginController">

    <VBox styleClass="card, bg-default, elevated-1" spacing="12" maxWidth="420" alignment="TOP_LEFT">
        <padding><Insets top="28" right="28" bottom="28" left="28" /></padding>

        <Label text="Goanna Watch" styleClass="title-3, accent" />
        <Label text="Welcome back." styleClass="title-1" />
        <Label text="Sign in to continue recording local wildlife." styleClass="text-muted" wrapText="true" />

        <Label text="Email address" />
        <TextField fx:id="emailTextField" promptText="Enter your email address..." />

        <Label text="Password" />
        <PasswordField fx:id="passwordField" promptText="Enter your password..." />

        <Label fx:id="loginFeedbackLabel" styleClass="feedback" wrapText="true" maxWidth="Infinity"
               visible="false" managed="false" />

        <Button text="Log in" fx:id="loginButton" styleClass="accent" maxWidth="Infinity"
                onAction="#onNextButtonClick" />
        <Button text="Go back" fx:id="cancelButton" maxWidth="Infinity"
                onAction="#onCancelButtonClick" />

        <HBox alignment="CENTER" spacing="4">
            <Label text="Don't have a Goanna Watch account?" styleClass="text-muted" />
            <Hyperlink text="Sign up here" fx:id="signUpLink" onAction="#onSignupRedirectClick" />
        </HBox>
    </VBox>
</VBox>