<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="bg-inset"
      stylesheets="@pageStyling.css"
      prefHeight="800" prefWidth="800"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="GoannaWatch.observations.controller.FavouritesController">

    <fx:include fx:id="navBar" source="navbar.fxml" />

    <VBox spacing="16" VBox.vgrow="ALWAYS">
        <padding><Insets top="20" right="24" bottom="24" left="24" /></padding>

        <VBox spacing="2">
            <Label text="My Favourites" styleClass="title-1" />
            <Label text="Here are your favourite observations!" styleClass="text-muted" />
        </VBox>

        <VBox styleClass="card, bg-default, elevated-1" VBox.vgrow="ALWAYS">
            <TableView fx:id="favouritesTableView" styleClass="edge-to-edge, alternating-rows"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="observerColumn" text="Observer" />
                    <TableColumn fx:id="locationColumn" text="Location" />
                    <TableColumn fx:id="animalColumn" text="Animal" />
                    <TableColumn fx:id="endangerColumn" text="Endangered" />
                    <TableColumn fx:id="dateColumn" text="Date" />
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>