<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="bg-inset" alignment="CENTER"
      stylesheets="@pageStyling.css"
      prefHeight="800" prefWidth="800"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GoannaWatch.account.controller.SignupController">

    <VBox styleClass="card, bg-default, elevated-1" spacing="10" maxWidth="420" alignment="TOP_LEFT">
        <padding><Insets top="28" right="28" bottom="28" left="28" /></padding>

        <Label text="Goanna Watch" styleClass="title-3, accent" />
        <Label text="Create your account" styleClass="title-1" />
        <Label text="Sign up to begin recording local wildlife." styleClass="text-muted" wrapText="true" />

        <HBox spacing="10">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="First name" />
                <TextField fx:id="firstNameTextField" promptText="First name..." />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Last name" />
                <TextField fx:id="lastNameTextField" promptText="Last name..." />
            </VBox>
        </HBox>

        <Label text="Email address" />
        <TextField fx:id="emailTextField" promptText="Enter your email address..." />

        <Label text="Password" />
        <PasswordField fx:id="passwordField" promptText="Enter your password..." />

        <Label text="Confirm password" />
        <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password..." />

        <Label fx:id="signupFeedbackLabel" styleClass="feedback" wrapText="true" maxWidth="Infinity"
               visible="false" managed="false" />

        <!-- Uncomment when ready to add extra account types
        <Label text="User type" />
        <ChoiceBox fx:id="userType" onShowing="#userTypeChoice" />
        -->

        <Button text="Sign up" fx:id="submitButton" styleClass="accent" maxWidth="Infinity"
                onAction="#onSubmitButtonClick" />
        <Button text="Go back" fx:id="cancelButton" maxWidth="Infinity"
                onAction="#onCancelButtonClick" />

        <HBox alignment="CENTER" spacing="4">
            <Label text="Already have a Goanna Watch account?" styleClass="text-muted" />
            <Hyperlink text="Log in here" fx:id="loginLink" onAction="#onLoginButtonClick" />
        </HBox>
    </VBox>
</VBox>