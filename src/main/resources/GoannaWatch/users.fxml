<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER"
      spacing="15"
      prefWidth="800"
      prefHeight="600"
      stylesheets="@pageStyling.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GoannaWatch.account.controller.UsersController">

    <Label text="Manage Users"
           style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <TableView fx:id="usersTable" prefHeight="400">
        <columns>
            <TableColumn fx:id="nameColumn"
                         text="Name" prefWidth="220" />
            <TableColumn fx:id="emailColumn"
                         text="Email" prefWidth="320" />
            <TableColumn fx:id="roleColumn"
                         text="Role" prefWidth="120" />
        </columns>
    </TableView>

    <Label fx:id="messageLabel" />

    <HBox alignment="CENTER" spacing="15">
        <Button text="Grant Expert"
                onAction="#onGrantExpertClick" />
        <Button text="Back"
                onAction="#onBackClick" />
    </HBox>
</VBox>