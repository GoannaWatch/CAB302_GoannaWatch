<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="bg-inset"
      stylesheets="@pageStyling.css"
      prefHeight="800" prefWidth="800"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="GoannaWatch.observations.controller.HistoryController">

    <fx:include fx:id="navBar" source="navbar.fxml" />

    <VBox spacing="16" VBox.vgrow="ALWAYS">
        <padding><Insets top="20" right="24" bottom="24" left="24" /></padding>

        <VBox spacing="2">
            <Label text="Observation History" styleClass="title-1" />
            <Label text="Select an observation to view or edit." styleClass="text-muted" />
        </VBox>

        <HBox spacing="12" VBox.vgrow="ALWAYS">

            <VBox styleClass="card, bg-default, elevated-1" spacing="10" HBox.hgrow="ALWAYS">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="searchTextField" promptText="Search by animal or location..."
                               HBox.hgrow="ALWAYS" />
                    <CheckBox fx:id="showMineOnlyCheck" text="Only mine" onAction="#onFilterChanged" />
                </HBox>

                <TableView fx:id="observationsTableView" styleClass="edge-to-edge, alternating-rows"
                           VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="observerColumn" text="Observer" />
                        <TableColumn fx:id="locationColumn" text="Location" />
                        <TableColumn fx:id="animalColumn" text="Animal" />
                        <TableColumn fx:id="endangerColumn" text="Endangered" />
                        <TableColumn fx:id="dateColumn" text="Date" />
                        <TableColumn fx:id="favouriteColumn" text="Favourite" />
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Export table" onAction="#onExport" />
                    <Label fx:id="ExportSuccessMsg" styleClass="text-muted" />
                </HBox>
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="400" minWidth="400"
                        styleClass="edge-to-edge" fx:id="detailScroll">
                <VBox fx:id="observationContainer" styleClass="card, bg-default, elevated-1" spacing="12">
                    <Label text="Observation details" styleClass="title-4" />

                    <fx:define>
                        <ToggleGroup fx:id="isEndangered" />
                    </fx:define>

                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="80" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <Label text="Location" styleClass="text-muted" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="locationTextField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Animal" styleClass="text-muted" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <ComboBox fx:id="speciesComboBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Endangered" styleClass="text-muted" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <HBox spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <RadioButton fx:id="endangeredYesRadio" text="Yes" toggleGroup="$isEndangered" />
                            <RadioButton fx:id="endangeredNoRadio" text="No" toggleGroup="$isEndangered" />
                        </HBox>

                        <Label text="Date" styleClass="text-muted" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <DatePicker fx:id="datePicker" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Image" styleClass="text-muted" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="4">
                            <Button text="Choose Image" onAction="#onChooseImage" />
                            <Label fx:id="imageLabel" text="No image selected" wrapText="true" styleClass="text-muted" />
                        </HBox>

                        <Label text="Video" styleClass="text-muted" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="5">
                            <Button text="Choose Video" onAction="#onChooseVideo" />
                            <Label fx:id="videoLabel" text="No video selected" wrapText="true" styleClass="text-muted" />
                        </HBox>
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel" />
                        <Button fx:id="deleteButton" text="Delete" styleClass="danger" onAction="#onDelete" />
                        <Button fx:id="confirmButton" text="Confirm" styleClass="accent" onAction="#onEditConfirm" />
                    </HBox>

                    <Separator />

                    <Label text="Comments" styleClass="title-4" />
                    <TextArea fx:id="commentsArea" editable="false" wrapText="true" prefHeight="120" />

                    <VBox fx:id="commentForm" spacing="10" visible="false" managed="false">
                        <TextArea fx:id="commentTextArea" promptText="Write a comment..." wrapText="true" prefHeight="80" />
                        <Button fx:id="addCommentButton" text="Add Comment" styleClass="accent" onAction="#onAddComment" />
                    </VBox>
                </VBox>
            </ScrollPane>
        </HBox>
    </VBox>
</VBox>